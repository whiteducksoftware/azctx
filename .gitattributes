# Exact JSON contract fixtures must retain LF on every checkout, including Windows.
/cmd/testdata/contract/*.golden text eol=lf

# Shell and pipeline exports are exact LF, independently of the host shell.
/cmd/testdata/env/*.golden text eol=lf

# MFA stderr fixtures are exact LF lines; parser tests construct CRLF explicitly.
/internal/azcli/testdata/mfa/*.stderr.golden text eol=lf

# Generated CLI reference freshness compares exact bytes on every checkout.
/docs/cli/*.md text eol=lf

# Keep portable skill frontmatter and its cached plugin copy byte-identical.
/skills/**/SKILL.md text eol=lf
/plugins/**/SKILL.md text eol=lf

# Exact real GoReleaser and brew style release fixtures are compared byte for byte.
/.github/scripts/testdata/** text eol=lf
