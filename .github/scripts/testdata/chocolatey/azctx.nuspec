  <metadata>
    <id>azctx</id>
    <version>2026.11.0</version>
    <owners>white duck GmbH</owners>
    <title>azctx</title>
    <authors>white duck GmbH</authors>
    <projectUrl>https://github.com/whiteducksoftware/azctx</projectUrl>
